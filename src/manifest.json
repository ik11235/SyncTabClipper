{
  "name": "SyncTabClipper",
  "version": "0.3.0",
  "manifest_version": 3,
  "description": "__MSG_Description__",
  "default_locale": "en",
  "permissions": ["tabs", "storage", "contextMenus"],
  "background": {
    "service_worker": "js/background.js"
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icon16.png"
    }
  }
}
